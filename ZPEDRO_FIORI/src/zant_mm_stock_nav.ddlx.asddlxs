@Metadata.layer: #PARTNER
@UI.headerInfo: {
                  title:       { label: 'Manutenção de Estoque', value: 'matnr' },
                  description: {
                                 label: 'Material',
                                 value: 'matnr'
                  },
                  typeName:       'Manutenção de Estoque',
                  typeNamePlural: 'Manutenção de Estoques'
}
annotate view ZI_MM_STOCK_NAV with
{
  @UI.facet: [{
                id: 'GeneralIdentificationID',
                type: #IDENTIFICATION_REFERENCE,
                position: 10,
                label: 'Dados Gerais'
    },
    { 
                id: 'MatID',
                type: #IDENTIFICATION_REFERENCE,
                label: 'Material',
                position: 20,
                targetElement: '_mat'
    },
    { 
                id: 'LocID',
                type: #IDENTIFICATION_REFERENCE,
                label: 'Local',
                position: 30,
                targetElement: '_loc'
    },
    { 
                id: 'MovID',
                type: #LINEITEM_REFERENCE,
                label: 'Movimentação',
                position: 40,
                targetElement: '_mov'
    },
    { 
                id: 'InvID',
                type: #LINEITEM_REFERENCE,
                label: 'Inventário',
                position: 50,
                targetElement: '_inv'
    }
  ]

  @UI: {
         selectionField: [{ position: 10 }],
         lineItem: [{ position: 10 }],
         identification: [{ position: 10 }]
  }
  matnr;
  
  @UI: {
         selectionField: [{ position: 20 }],
         lineItem: [{ position: 20 }],
         identification: [{ position: 20 }]
  }
  locid;
  
  @UI: {
         lineItem: [{ position: 30 }],
         identification: [{ position: 30 }]
  }
  qty;
  
  @UI: {
         lineItem: [{ position: 40 }],
         identification: [{ position: 40 }]
  }
  dt_atualiz;

}