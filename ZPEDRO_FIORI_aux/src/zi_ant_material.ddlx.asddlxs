@Metadata.layer: #PARTNER
@UI.headerInfo: {
    title: {
        label: 'Material',
        value: 'matnr'
    },
    description: {
        label: 'Descrição',
        value: 'descr'
    },
    typeName: 'Material',
    typeNamePlural: 'Materiais'
}
annotate view ZI_SD_MATERIAL_NEW with
{
  @UI.facet: [{ id: 'MatIdentificationID', type: #IDENTIFICATION_REFERENCE }]

  @UI: {
     selectionField: [{
        position: 10
     }],
     lineItem: [{ position: 10 }],
     identification: [{ position: 10 }]
  }
  matnr;

  @UI: {
     lineItem: [{ position: 20 }],
     identification: [{ position: 20 }]
  }
  descr;

  @UI: {
   lineItem: [{ position: 30, importance: #HIGH }],
   identification: [{ position: 30 }]
  }
  unid;

  @UI: {
   lineItem: [{ position: 40 }],
   identification: [{ position: 40 }]
  }
  ativo;
}